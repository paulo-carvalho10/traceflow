# O .env da publicação, na raiz do projeto no servidor. O deploy/instalar.sh gera um com
# segredos aleatórios; este arquivo só mostra o que vai nele. O .env nunca entra no git.

# O endereço público. Sem domínio próprio, o sslip.io devolve o IP que está no próprio nome:
# 129-146-10-20.sslip.io aponta para 129.146.10.20.
TRACEFLOW_SITE=129-146-10-20.sslip.io

# openssl rand -hex 24
POSTGRES_PASSWORD=troque-por-um-segredo
# openssl rand -hex 32 (a API se recusa a subir em produção com o segredo de desenvolvimento)
TRACEFLOW_JWT_SECRET=troque-por-um-segredo-longo
# a chave com que a loja manda os spans: tf_<8 letras ou números>_<24 ou mais caracteres>
TRACEFLOW_DEMO_INGEST_KEY=tf_abcd1234_troque-por-um-segredo-de-verdade
